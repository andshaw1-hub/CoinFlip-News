# ── Food Tracker Pro — Environment Configuration ──────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Session — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Database (optional — defaults to ./data.db)
DATABASE_PATH=./data.db

# Anthropic API — powers content generation
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Stripe
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PRICE_ID=<your-stripe-price-id>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>

# Google AdSense (optional)
ADSENSE_PUBLISHER_ID=<your-adsense-publisher-id>
ADSENSE_SLOT_LEADERBOARD=
ADSENSE_SLOT_RECTANGLE=
ADSENSE_SLOT_BANNER_TOP=
ADSENSE_SLOT_BANNER_MID=
